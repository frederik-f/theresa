# OGS run directories (meshes, project files, results); regenerated by
# `theresa train`, `simulate` and `validate`.
/runs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Local editor and agent configuration
.claude/

